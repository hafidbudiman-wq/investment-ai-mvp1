generator client {
  provider = "prisma-client-js"
}

datasource db {
  provider = "postgresql"
  url      = env("DATABASE_URL")
}

enum ReportPeriodType {
  Q1
  H1
  Q3
  FY
  MONTHLY
}

enum ReviewStatus {
  DRAFT
  PENDING_REVIEW
  VERIFIED
  REJECTED
}

enum StatementType {
  INCOME_STATEMENT
  BALANCE_SHEET
  CASH_FLOW
  OTHER
}

enum SourceType {
  MANUAL
  PDF
  EXCEL
  API
}

enum ValueNature {
  FLOW
  STOCK
  PER_SHARE
  RATIO
  TEXT
}

enum MappingMethod {
  MANUAL
  RULE
  AI
}

enum WarningSeverity {
  LOW
  MEDIUM
  HIGH
  CRITICAL
}

enum ExtractionRunStatus {
  UPLOADED
  PROCESSING
  PENDING_REVIEW
  READY_TO_COMMIT
  COMMITTED
  FAILED
}

enum ExtractionCandidateStatus {
  PENDING
  ACCEPTED
  REJECTED
  COMMITTED
}

enum ExtractionChunkType {
  SECTION
  TABLE
  PAGE
  TOKEN_BLOCK
}

model Company {
  id             String            @id @default(cuid())
  ticker         String            @unique
  name           String
  sector         String?
  subsector      String?
  country        String            @default("ID")
  ipoYear        Int?
  currency       String            @default("IDR")
  fiscalYearEnd  Int               @default(12)
  isActive       Boolean           @default(true)
  reports        FinancialReport[]
  extractionRuns ExtractionRun[]
  createdAt      DateTime          @default(now())
  updatedAt      DateTime          @updatedAt
}

model FinancialReport {
  id             String               @id @default(cuid())
  companyId      String
  company        Company              @relation(fields: [companyId], references: [id], onDelete: Cascade)
  year           Int
  periodType     ReportPeriodType
  periodStart    DateTime?
  periodEnd      DateTime
  audited        Boolean              @default(false)
  consolidated   Boolean              @default(true)
  sourceType     SourceType           @default(MANUAL)
  sourceFile     String?
  status         ReviewStatus         @default(DRAFT)
  statements     FinancialStatement[]
  entries        FinancialEntry[]
  warnings       DataWarning[]
  sourceFiles    SourceFile[]
  auditLogs      AuditLog[]
  extractionRuns ExtractionRun[]
  createdBy      String?
  createdAt      DateTime             @default(now())
  updatedAt      DateTime             @updatedAt

  @@unique([companyId, year, periodType])
  @@index([companyId, periodEnd])
  @@index([status])
}

model FinancialStatement {
  id             String           @id @default(cuid())
  reportId       String
  report         FinancialReport  @relation(fields: [reportId], references: [id], onDelete: Cascade)
  statementType  StatementType
  currency       String
  unitScale      Int              @default(1)
  isConsolidated Boolean          @default(true)
  entries        FinancialEntry[]
  createdAt      DateTime         @default(now())
  updatedAt      DateTime         @updatedAt

  @@unique([reportId, statementType])
}

model CanonicalAccount {
  id                   String                @id @default(cuid())
  code                 String                @unique
  name                 String
  displayNameId        String?
  description          String?
  definition           String?
  investorMeaning      String?
  aliases              Json?
  relatedMetrics       Json?
  positiveSignals      Json?
  redFlags             Json?
  sectorNotes          Json?
  sourceRefs           Json?
  statementType        StatementType
  valueNature          ValueNature           @default(FLOW)
  normalBalance        String?
  parentId             String?
  parent               CanonicalAccount?     @relation("AccountHierarchy", fields: [parentId], references: [id])
  children             CanonicalAccount[]    @relation("AccountHierarchy")
  level                Int                   @default(1)
  sortOrder            Int                   @default(0)
  isCalculated         Boolean               @default(false)
  formula              String?
  isActive             Boolean               @default(true)
  entries              FinancialEntry[]
  mappings             AccountMapping[]
  extractionCandidates ExtractionCandidate[]
  createdAt            DateTime              @default(now())
  updatedAt            DateTime              @default(now()) @updatedAt

  @@index([statementType, sortOrder])
  @@index([parentId])
}

model FinancialEntry {
  id                 String              @id @default(cuid())
  reportId           String
  report             FinancialReport     @relation(fields: [reportId], references: [id], onDelete: Cascade)
  statementId        String?
  statement          FinancialStatement? @relation(fields: [statementId], references: [id], onDelete: Cascade)
  canonicalAccountId String
  canonicalAccount   CanonicalAccount    @relation(fields: [canonicalAccountId], references: [id])
  reportedLabel      String?
  rawText            String?
  value              Decimal             @db.Decimal(28, 6)
  originalValue      Decimal?            @db.Decimal(28, 6)
  normalizedValue    Decimal?            @db.Decimal(38, 6)
  originalRawValue   String?
  scale              Int                 @default(1)
  currency           String              @default("IDR")
  signConvention     String?
  isEstimated        Boolean             @default(false)
  isVerified         Boolean             @default(false)
  confidence         Float?
  sourcePage         Int?
  sourceDocumentId   String?
  sourceDocument     FinancialDocument?  @relation(fields: [sourceDocumentId], references: [id], onDelete: SetNull)
  extractionRunId    String?
  extractionRun      ExtractionRun?      @relation(fields: [extractionRunId], references: [id], onDelete: SetNull)
  sourceCandidateIds Json?
  reviewStatus       ReviewStatus        @default(VERIFIED)
  reviewedBy         String?
  reviewedAt         DateTime?
  createdAt          DateTime            @default(now())
  updatedAt          DateTime            @updatedAt

  @@unique([reportId, canonicalAccountId])
  @@index([canonicalAccountId])
  @@index([statementId])
  @@index([sourceDocumentId])
  @@index([extractionRunId])
}

model AccountMapping {
  id                 String           @id @default(cuid())
  sourceLabel        String           @unique
  normalizedLabel    String?
  companyId          String?
  statementType      StatementType?
  canonicalAccountId String
  canonicalAccount   CanonicalAccount @relation(fields: [canonicalAccountId], references: [id])
  method             MappingMethod    @default(MANUAL)
  confidence         Float?
  isApproved         Boolean          @default(false)
  createdAt          DateTime         @default(now())
  updatedAt          DateTime         @default(now()) @updatedAt

  @@index([normalizedLabel])
  @@index([companyId, statementType])
}

model DataWarning {
  id         String          @id @default(cuid())
  reportId   String
  report     FinancialReport @relation(fields: [reportId], references: [id], onDelete: Cascade)
  code       String
  message    String
  severity   String
  resolved   Boolean         @default(false)
  resolvedBy String?
  resolvedAt DateTime?
  createdAt  DateTime        @default(now())

  @@index([reportId, resolved])
  @@index([severity])
}

model SourceFile {
  id         String          @id @default(cuid())
  reportId   String
  report     FinancialReport @relation(fields: [reportId], references: [id], onDelete: Cascade)
  sourceType SourceType
  fileName   String
  filePath   String?
  mimeType   String?
  fileSize   Int?
  checksum   String?
  uploadedAt DateTime        @default(now())

  @@index([reportId])
}

model AuditLog {
  id        String           @id @default(cuid())
  reportId  String?
  report    FinancialReport? @relation(fields: [reportId], references: [id], onDelete: SetNull)
  action    String
  actor     String?
  entity    String?
  entityId  String?
  before    Json?
  after     Json?
  note      String?
  createdAt DateTime         @default(now())

  @@index([reportId, createdAt])
  @@index([entity, entityId])
}

model ExtractionRun {
  id            String                @id @default(cuid())
  companyId     String
  company       Company               @relation(fields: [companyId], references: [id], onDelete: Cascade)
  reportId      String?
  report        FinancialReport?      @relation(fields: [reportId], references: [id], onDelete: SetNull)
  fileName      String
  mimeType      String                @default("application/pdf")
  fileSize      Int
  checksum      String
  year          Int?
  periodType    ReportPeriodType?
  currency      String?
  unitScale     Int?
  status        ExtractionRunStatus   @default(UPLOADED)
  parserVersion String                @default("mvp-1.2d-v1")
  pageCount     Int?
  errorMessage  String?
  chunks        ExtractionChunk[]
  candidates    ExtractionCandidate[]
  asyncJob      AsyncExtractionJob?
  documentId    String?
  document      FinancialDocument?    @relation(fields: [documentId], references: [id], onDelete: SetNull)
  reviewedFacts FinancialEntry[]
  createdAt     DateTime              @default(now())
  updatedAt     DateTime              @default(now()) @updatedAt

  @@unique([companyId, checksum])
  @@index([companyId, createdAt])
  @@index([status])
  @@index([documentId])
}

model ExtractionChunk {
  id         String                @id @default(cuid())
  runId      String
  run        ExtractionRun         @relation(fields: [runId], references: [id], onDelete: Cascade)
  ordinal    Int
  chunkType  ExtractionChunkType
  pageStart  Int?
  pageEnd    Int?
  section    String?
  text       String
  textHash   String?
  metadata   Json?
  candidates ExtractionCandidate[]
  createdAt  DateTime              @default(now())

  @@unique([runId, ordinal])
  @@index([runId, pageStart])
}

model ExtractionCandidate {
  id                   String                    @id @default(cuid())
  runId                String
  run                  ExtractionRun             @relation(fields: [runId], references: [id], onDelete: Cascade)
  chunkId              String?
  chunk                ExtractionChunk?          @relation(fields: [chunkId], references: [id], onDelete: SetNull)
  statementType        StatementType?
  reportedLabel        String
  normalizedLabel      String?
  rawValue             String
  numericValue         Decimal?                  @db.Decimal(28, 6)
  currency             String?
  scale                Int                       @default(1)
  sourcePage           Int?
  sourceText           String?
  canonicalAccountId   String?
  canonicalAccount     CanonicalAccount?         @relation(fields: [canonicalAccountId], references: [id], onDelete: SetNull)
  extractionConfidence Float?
  mappingConfidence    Float?
  mappingMethod        MappingMethod?
  status               ExtractionCandidateStatus @default(PENDING)
  reviewNote           String?
  reviewedBy           String?
  reviewedAt           DateTime?
  createdAt            DateTime                  @default(now())
  updatedAt            DateTime                  @default(now()) @updatedAt

  @@index([runId, status])
  @@index([canonicalAccountId])
  @@index([chunkId])
}

model AsyncExtractionJob {
  id                  String             @id
  fileName            String
  mimeType            String             @default("application/pdf")
  fileSize            Int
  checksum            String             @unique
  status              String             @default("UPLOADED")
  openAiResponseId    String?
  runId               String?            @unique
  run                 ExtractionRun?     @relation(fields: [runId], references: [id], onDelete: SetNull)
  documentId          String?
  document            FinancialDocument? @relation(fields: [documentId], references: [id], onDelete: SetNull)
  detectedTicker      String?
  detectedCompanyName String?
  detectedYear        Int?
  detectedPeriodType  String?
  errorMessage        String?
  preflight           Json?
  fileData            Bytes?
  createdAt           DateTime           @default(now())
  updatedAt           DateTime           @updatedAt

  @@index([status, createdAt])
  @@index([documentId])
}

model UploadSession {
  id               String             @id @default(cuid())
  correlationId    String             @unique
  uploadMode       String
  status           String             @default("INITIATED")
  storageProvider  String
  bucket           String
  objectKey        String             @unique
  providerUploadId String?
  originalFileName String
  mimeType         String
  expectedSize     Int
  partSize         Int?
  resumeTokenHash  String
  lastPartNumber   Int?
  errorCode        String?
  errorMessage     String?
  expiresAt        DateTime
  completedAt      DateTime?
  parts            UploadPart[]
  document         FinancialDocument?
  createdAt        DateTime           @default(now())
  updatedAt        DateTime           @updatedAt

  @@index([status, expiresAt])
}

model UploadPart {
  id              String        @id @default(cuid())
  uploadSessionId String
  uploadSession   UploadSession @relation(fields: [uploadSessionId], references: [id], onDelete: Cascade)
  partNumber      Int
  etag            String
  size            Int
  completedAt     DateTime      @default(now())
  createdAt       DateTime      @default(now())

  @@unique([uploadSessionId, partNumber])
  @@index([uploadSessionId, completedAt])
}

model FinancialDocument {
  id                 String               @id @default(cuid())
  uploadSessionId    String?              @unique
  uploadSession      UploadSession?       @relation(fields: [uploadSessionId], references: [id], onDelete: SetNull)
  storageProvider    String
  bucket             String
  objectKey          String               @unique
  originalFileName   String
  mimeType           String
  verifiedSize       Int
  sha256             String?
  content            Bytes?
  magicBytesVerified Boolean              @default(false)
  status             String               @default("UPLOADED")
  uploadedBy         String?
  verifiedAt         DateTime?
  jobs               Job[]
  asyncJobs          AsyncExtractionJob[]
  extractionRuns     ExtractionRun[]
  reviewedFacts      FinancialEntry[]
  metadataAssertions MetadataAssertion[]
  createdAt          DateTime             @default(now())
  updatedAt          DateTime             @updatedAt

  @@index([sha256])
  @@index([status, createdAt])
}

model Job {
  id                 String             @id @default(cuid())
  correlationId      String
  type               String
  status             String             @default("QUEUED")
  priority           Int                @default(100)
  payload            Json
  deduplicationKey   String?
  documentId         String?
  document           FinancialDocument? @relation(fields: [documentId], references: [id], onDelete: SetNull)
  attemptCount       Int                @default(0)
  maxAttempts        Int                @default(3)
  availableAt        DateTime           @default(now())
  claimedBy          String?
  claimToken         String?
  claimedAt          DateTime?
  leaseExpiresAt     DateTime?
  lastHeartbeatAt    DateTime?
  providerResponseId String?
  errorCode          String?
  errorMessage       String?
  completedAt        DateTime?
  attempts           JobAttempt[]
  events             JobEvent[]
  createdAt          DateTime           @default(now())
  updatedAt          DateTime           @updatedAt

  @@index([correlationId])
  @@index([status, availableAt, priority, createdAt])
  @@index([status, leaseExpiresAt])
  @@index([documentId])
}

model JobAttempt {
  id                 String     @id @default(cuid())
  jobId              String
  job                Job        @relation(fields: [jobId], references: [id], onDelete: Cascade)
  attemptNumber      Int
  workerId           String?
  claimToken         String?
  status             String
  startedAt          DateTime   @default(now())
  finishedAt         DateTime?
  durationMs         Int?
  providerRequestId  String?
  providerResponseId String?
  errorCode          String?
  errorMessage       String?
  events             JobEvent[]
  createdAt          DateTime   @default(now())

  @@unique([jobId, attemptNumber])
  @@index([jobId, startedAt])
}

model JobEvent {
  id         String      @id @default(cuid())
  jobId      String
  job        Job         @relation(fields: [jobId], references: [id], onDelete: Cascade)
  attemptId  String?
  attempt    JobAttempt? @relation(fields: [attemptId], references: [id], onDelete: SetNull)
  eventType  String
  fromStatus String?
  toStatus   String?
  stage      String?
  message    String?
  metadata   Json?
  createdAt  DateTime    @default(now())

  @@index([jobId, createdAt])
  @@index([attemptId])
}

model MetadataAssertion {
  id            String            @id @default(cuid())
  documentId    String
  document      FinancialDocument @relation(fields: [documentId], references: [id], onDelete: Cascade)
  field         String
  proposedValue Json
  confidence    Float?
  sourcePage    Int?
  sourceText    String?
  status        String            @default("PROPOSED")
  reviewedBy    String?
  reviewedAt    DateTime?
  reviewNote    String?
  createdAt     DateTime          @default(now())
  updatedAt     DateTime          @updatedAt

  @@index([documentId, field])
  @@index([status])
}
