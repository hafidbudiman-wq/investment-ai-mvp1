{
  "name": "investment-ai-stock-analysis",
  "version": "0.1.0",
  "private": true,
  "engines": {
    "node": "22.x",
    "npm": ">=10 <12"
  },
  "scripts": {
    "dev": "next dev",
    "build": "next build",
    "start": "prisma migrate deploy && npm run db:seed && next start",
    "start:app": "next start",
    "start:worker": "tsx scripts/pdf-worker.ts",
    "postinstall": "prisma generate",
    "lint": "eslint . --max-warnings=0",
    "typecheck": "tsc --noEmit",
    "test": "node --import tsx --test tests/**/*.test.ts",
    "test:platform": "node --import tsx --test tests/platform/*.test.ts",
    "test:platform:integration": "node --import tsx tests/platform/job-repository.integration.ts",
    "db:generate": "prisma generate",
    "db:push": "prisma db push",
    "db:migrate": "prisma migrate dev",
    "db:deploy": "prisma migrate deploy",
    "db:studio": "prisma studio",
    "db:seed": "tsx prisma/seed.ts"
  },
  "prisma": {
    "seed": "tsx prisma/seed.ts"
  },
  "dependencies": {
    "@aws-sdk/client-s3": "3.1095.0",
    "@aws-sdk/s3-request-presigner": "3.1095.0",
    "@prisma/client": "6.12.0",
    "lucide-react": "0.468.0",
    "next": "15.5.20",
    "pdf-lib": "^1.17.1",
    "react": "19.1.0",
    "react-dom": "19.1.0",
    "recharts": "2.15.4",
    "zod": "3.25.76"
  },
  "devDependencies": {
    "@types/node": "22.15.30",
    "@types/react": "19.1.8",
    "@types/react-dom": "19.1.6",
    "eslint": "8.57.1",
    "eslint-config-next": "15.5.20",
    "prisma": "6.12.0",
    "tsx": "4.20.3",
    "typescript": "5.8.3"
  }
}
